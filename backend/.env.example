# Copy to .env and fill in real values. Never commit the filled-in copy.
# No real secrets belong in this repository.

# --- runtime ---
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3001

# --- database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=dhaka_tesla_pool
DATABASE_SSL=false

# --- auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# --- seed ---
# true also seeds the demo ride scenario used in the walkthrough
SEED_DEMO_SCENARIO=false