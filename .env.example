# Copy to .env and fill in real values. Never commit the filled-in copy.
# Docker Compose reads this file from the repository root.

# --- database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dhaka_tesla_pool

# --- api ---
NODE_ENV=development
API_PORT=3000
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=dhaka_tesla_pool
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# --- frontend ---
WEB_PORT=3001
# Browser-reachable URL of the API, including /api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1